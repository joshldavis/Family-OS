# ─── Required for AI features ────────────────────────────────────────────────
# Google Gemini API key — powers AI Chat, AI Scan, Insights, and Chore suggestions
# Get yours free at: https://aistudio.google.com/app/apikey
VITE_API_KEY=your_gemini_api_key_here

# Anthropic API key — powers the AI Family Briefing on the Dashboard
# Get yours at: https://console.anthropic.com/settings/keys
VITE_ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─── Required for Weather Widget ─────────────────────────────────────────────
# OpenWeatherMap API key — free tier is plenty
# Get yours at: https://home.openweathermap.org/api_keys
VITE_OPENWEATHER_KEY=your_openweathermap_api_key_here

# ─── Optional: Real Authentication (skip for demo) ───────────────────────────
# Without these the app runs in localStorage/demo mode — perfect for showing off.
# Add these later when you want each family member to have their own login.
# Set up a free project at: https://supabase.com
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─── Optional: Google Calendar OAuth (skip for demo) ─────────────────────────
# Only needed for the real Google Calendar sync in Settings.
# Create credentials at: https://console.cloud.google.com
VITE_GOOGLE_CLIENT_ID=
